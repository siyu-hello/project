<view class="page"><text class="title">我的首页</text><text class="error">{{error}}</text><block wx:if="{{account}}"><text>{{account.name}}</text><block wx:if="{{account.role === 'STUDENT' && summary}}"><view class="card"><text>可用积分 {{summary.availablePoints}} 分</text><text>累计志愿时长 {{summary.volunteerMinutes}} 分钟</text></view><text>可报名活动</text><view wx:for="{{activities}}" wx:key="id" class="card"><text>{{item.title}}</text><text>剩余名额 {{item.remainingCapacity}}</text></view><text wx:if="{{!activities.length}}">当前没有面向你的可报名活动</text></block><view wx:if="{{account.role === 'PUBLISHER'}}" class="card"><text>发布者入口</text><text>活动发布功能将在后续版本接入</text></view><view wx:if="{{account.role === 'REDEEMER'}}" class="card"><text>核销入口</text><text>核销功能将在后续版本接入</text></view></block><button bindtap="logout">退出 / 切换账号</button></view>
