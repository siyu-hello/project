<view class="editorial catalog">
  <view class="ed-heading"><text class="ed-title">校园活动</text><button class="ed-link" bindtap="refresh">刷新</button></view>
  <view class="ed-tabs">
    <view wx:for="{{types}}" wx:key="value" class="ed-tab {{typeIndex === index ? 'on' : ''}}" bindtap="pickType" data-index="{{index}}">{{item.label}}</view>
    <view class="ed-link sort" bindtap="toggleSort">{{sortLabel}}</view>
  </view>

  <text wx:if="{{error}}" class="error">{{error}}</text>

  <view wx:if="{{loading}}" class="skeleton">
    <view class="sk-card"></view><view class="sk-card"></view><view class="sk-card"></view>
  </view>

  <block wx:if="{{!loading}}">
    <view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="day-group">
      <text class="day-heading">{{group.label}}</text>
      <view wx:for="{{group.items}}" wx:key="id" class="agenda-row" bindtap="openActivity" data-id="{{item.id}}">
        <text class="agenda-time">{{item.timeText}}</text>
        <view class="act-main">
          <text class="act-title">{{item.title}}</text>
          <text class="meta">{{item.placeText}}</text>
          <view class="agenda-meta">
            <text class="{{item.tagClass}}">{{item.typeText}}</text>
            <text class="agenda-capacity {{item.full ? 'full' : ''}}">{{item.capacityText}}</text>
          </view>
        </view>
        <text class="agenda-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{!items.length && !error}}" class="empty">
      <text>当前没有可报名的活动</text>
      <text>下拉刷新看看有没有新发布</text>
    </view>
  </block>

</view>