<view class="page"><text class="title">校园活动</text><text>使用已开通的独立账号登录</text><button bindtap="login" loading="{{busy}}" disabled="{{busy}}">微信一键登录</button><view wx:for="{{accounts}}" wx:key="id"><button bindtap="login" data-id="{{item.id}}">进入 {{item.identifier}} · {{item.role}}</button></view><view class="card"><text>首次使用 · 绑定已有账号</text><input placeholder="学号 / 独立角色账号" value="{{identifier}}" bindinput="identifierInput"/><input placeholder="管理员告知的初始密码" password value="{{password}}" bindinput="passwordInput"/><button bindtap="login" data-bind="{{true}}" loading="{{busy}}" disabled="{{busy}}">验证并绑定</button></view><text class="error">{{error}}</text><text>账号尚未开通时，请联系管理员。参与活动与发布、核销须分别使用独立账号。</text></view>

