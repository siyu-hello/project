.order-card { gap: 14rpx; }
.order-head { display: flex; gap: 18rpx; align-items: center; }
.order-img {
  width: 120rpx; height: 120rpx;
  border-radius: 16rpx;
  background: #eef2f9;
  flex: none;
}
.order-ph { display: flex; align-items: center; justify-content: center; font-size: 48rpx; }
.order-title { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.code { font-family: "SF Mono", Menlo, Consolas, monospace; }
.gift-qr-overlay { position: fixed; inset: 0; z-index: 10; display: grid; place-items: center; padding: 24rpx; background: rgba(14, 36, 30, .58); }
.gift-qr-panel { box-sizing: border-box; display: flex; flex-direction: column; gap: 16rpx; padding: 28rpx; width: 100%; max-width: 420px; background: #fff; border-radius: 22rpx; }
.gift-qr-canvas { width: 240px; height: 240px; align-self: center; }
.gift-qr-panel button { margin: 0; }
