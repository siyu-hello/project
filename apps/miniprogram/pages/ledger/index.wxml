<view class="page">
  <view class="between">
    <view class="stack">
      <text class="title">积分与志愿时长</text>
      <text class="subtitle">余额 = 入账 − 兑换扣减 + 过期返还</text>
    </view>
    <text class="chip" bindtap="refresh">刷新</text>
  </view>

  <view class="balance">
    <view class="balance-item">
      <text class="balance-num">{{summary ? summary.availablePoints : '—'}}</text>
      <text class="balance-lab">可用积分</text>
    </view>
    <view class="balance-item">
      <text class="balance-num">{{summary ? summary.volunteerMinutes : '—'}}</text>
      <text class="balance-lab">志愿时长（分钟）</text>
    </view>
  </view>

  <text wx:if="{{error}}" class="error">{{error}}</text>
  <text wx:if="{{loading}}" class="empty">加载中…</text>

  <view wx:for="{{items}}" wx:key="id" class="card entry">
    <view class="between">
      <view class="stack">
        <text class="strong">{{item.title}}</text>
        <text class="tiny">{{item.ruleText}}</text>
      </view>
      <view class="amount-box">
        <text class="{{item.amountClass}}">{{item.amountText}} {{item.unitText}}</text>
        <text class="{{item.kindClass}}">{{item.kindText}}</text>
      </view>
    </view>
    <text class="tiny">{{item.timeText}}</text>
  </view>

  <text wx:if="{{!loading && !items.length && !error}}" class="empty">暂无流水记录</text>

  <view wx:if="{{items.length}}" class="between">
    <text class="tiny">已显示 {{items.length}} / {{total}} 条</text>
    <button wx:if="{{hasMore}}" class="btn ghost small" bindtap="loadMore" loading="{{more}}" disabled="{{more}}">加载更多</button>
    <text wx:else class="tiny">没有更多了</text>
  </view>
</view>