.act-hero { padding: 32rpx 28rpx 30rpx; }
.act-name { font-size: 42rpx; line-height: 1.35; }
.act-hero .hero-sub { margin-top: 10rpx; }
.hero-points {
  position: relative; z-index: 1;
  font-size: 24rpx; font-weight: 700;
  padding: 8rpx 20rpx; border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}
.green-badge { background: rgba(255, 255, 255, 0.22); color: #ffffff; }
.light-badge { background: rgba(255, 255, 255, 0.22); color: #ffffff; }
.scan-btn { height: 92rpx; line-height: 92rpx; font-size: 30rpx; }
.scan-panel .tiny { text-align: center; }
.act-hero .badge { color: #ffffff; }