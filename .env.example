# Copy to .env; choose private credentials before starting. No production secrets in source.
MYSQL_DATABASE=campus
MYSQL_USER=campus
MYSQL_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DATABASE_URL=mysql://campus:replace-with-a-long-random-database-password@localhost:3306/campus
ADMIN_IDENTIFIER=admin
ADMIN_INITIAL_PASSWORD=replace-with-at-least-10-characters
INITIAL_ACCOUNT_PASSWORD=123456
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ADMIN_ORIGIN=http://localhost:8080
PORT=3000
DO_NOT_TRACK=1
